                                                                    ]
                                                                },
                                                                {
                                                                    "or": [
                                                                        {
                                                                            "empty": [
                                                                                "@coalesce(triggerBody()?['filters']?['extDocumentTypesCsv'], '')"
                                                                            ]
                                                                        },
                                                                        {
                                                                            "contains": [
                                                                                "@concat(',', coalesce(triggerBody()?['filters']?['extDocumentTypesCsv'], ''), ',')",
                                                                                "@concat(',', items('FOREACH_Doc_Filter')?['type'], ',')"
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        "actions": {
                                                            "APPEND_Api_Doc": {
                                                                "type": "AppendToArrayVariable",
                                                                "inputs": {
                                                                    "name": "currentDocuments",

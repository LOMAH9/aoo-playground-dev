
              "SELECT_Blob_Items": {
                "type": "Select",
                "runAfter": { "BLOB_List_Blobs": ["Succeeded"] },
                "inputs": {
                  "from": "@body('BLOB_List_Blobs')?['value']",
                  "select": {
                    "externalId":    "@item()?['name']",
                    "umr":           null,
                    "insuredName":   null,
                    "inceptionDate": null,
                    "status":        null,
                    "updatedAt":     "@item()?['properties']?['lastModified']",
                    "documents":     "@createArray(createObject('documentId', item()?['name'], 'parentDocumentId', null, 'revision', item()?['properties']?['etag'], 'fileName', last(split(item()?['name'], '/')), 'digest', item()?['properties']?['contentMD5'], 'contentType', item()?['properties']?['contentType'], 'sizeBytes', item()?['properties']?['contentLength']))"
                  }
                }
              },

              "COMPOSE_GetMetadata_Response": {
                "type": "Compose",
                "runAfter": { "SELECT_Blob_Items": ["Succeeded"] },
                "inputs": {
                  "items":       "@body('SELECT_Blob_Items')",
                  "hasMore":     false,
                  "nextKey":     "",
                  "watermarkTo": "@utcNow()"
                }
              },


{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "HTTP_Trigger": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "schema": {
                        "type": "object",
                        "required": [
                            "workloadId",
                            "externalId",
                            "runId",
                            "correlationId",
                            "documents"
                        ],
                        "properties": {
                            "workloadId": {
                                "type": "string"
                            },
                            "externalId": {
                                "type": "string"
                            },
                            "runId": {
                                "type": "string"
                            },
                            "partnerId": {
                                "type": "string"
                            },
                            "correlationId": {
                                "type": "string"
                            },
                            "enableNotification": {
                                "type": "boolean"
                            },
                            "notificationType": {
                                "type": "string"
                            },
                            "notifyOnErrorsOnly": {
                                "type": "boolean"
                            },
                            "notificationRecipient": {
                                "type": "string"
                            },
                            "requestedAt": {
                                "type": "string"
                            },
                            "isReplay": {
                                "type": "boolean"
                            },
                            "documents": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "stagingBlobPath",
                                        "digest",
                                        "documentId",
                                        "revision",
                                        "fileName"
                                    ],
                                    "properties": {
                                        "stagingBlobPath": {
                                            "type": "string"
                                        },
                                        "digest": {
                                            "type": "string"
                                        },
                                        "documentId": {
                                            "type": "string"
                                        },
                                        "parentDocumentId": {
                                            "type": "string"
                                        },
                                        "revision": {
                                            "type": "string"
                                        },
                                        "fileName": {
                                            "type": "string"
                                        },
                                        "contentType": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "actions": {
            "INIT_Variables": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "correlationId",
                            "type": "string",
                            "value": "@triggerBody()?['correlationId']"
                        },
                        {
                            "name": "deliveredCount",
                            "type": "integer",
                            "value": 0
                        },
                        {
                            "name": "failedCount",
                            "type": "integer",
                            "value": 0
                        },
                        {
                            "name": "activityUploadResult",
                            "type": "object",
                            "value": {}
                        }
                    ]
                },
                "runAfter": {}
            },
            "TABLES_Get_Workload_By_ID": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "tableName": "DtsWorkloads",
                        "filterQuery": "@{concat('PartitionKey eq ''', triggerBody()?['workloadId'], ''' and RowKey eq ''', triggerBody()?['workloadId'], '''')}"
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/AzureTables"
                    }
                },
                "runAfter": {
                    "INIT_Variables": [
                        "Succeeded"
                    ]
                }
            },
            "TABLES_Get_Enabled_Document_Routings_For_Workload": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "tableName": "DtsWorkloadDocRouting",
                        "filterQuery": "@{concat('PartitionKey eq ''', triggerBody()?['workloadId'], ''' and IsEnabled eq true')}"
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/AzureTables"
                    }
                },
                "runAfter": {
                    "INIT_Variables": [
                        "Succeeded"
                    ]
                }
            },
            "TABLES_Get_Recorded_Risk_For_Workload": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "tableName": "DtsRisks",
                        "filterQuery": "@{concat('PartitionKey eq ''', triggerBody()?['workloadId'], ''' and RowKey eq ''', triggerBody()?['externalId'], '''')}"
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/AzureTables"
                    }
                },
                "runAfter": {
                    "INIT_Variables": [
                        "Succeeded"
                    ]
                }
            },
            "IF_Datastore_Entities_Are_Valid": {
                "type": "If",
                "expression": {
                    "and": [
                        {
                            "greater": [
                                "@length(body('TABLES_Get_Workload_By_ID')?['entities'])",
                                0
                            ]
                        },
                        {
                            "greater": [
                                "@length(body('TABLES_Get_Enabled_Document_Routings_For_Workload')?['entities'])",
                                0
                            ]
                        },
                        {
                            "greater": [
                                "@length(body('TABLES_Get_Recorded_Risk_For_Workload')?['entities'])",
                                0
                            ]
                        }
                    ]
                },
                "actions": {
                    "FOREACH_Document": {
                        "type": "Foreach",
                        "foreach": "@triggerBody()?['documents']",
                        "actions": {
                            "SCOPE_Try": {
                                "type": "Scope",
                                "actions": {
                                    "BLOB_Download_From_Staging": {
                                        "type": "ServiceProvider",
                                        "inputs": {
                                            "parameters": {
                                                "containerName": "@appsetting('blob_staging_container')",
                                                "blobName": "@items('FOREACH_Document')?['stagingBlobPath']"
                                            },
                                            "serviceProviderConfiguration": {
                                                "connectionName": "azureBlob",
                                                "operationId": "readBlob",
                                                "serviceProviderId": "/serviceProviders/AzureBlob"
                                            }
                                        }
                                    },
                                    "IF_Hash_Matches": {
                                        "type": "If",
                                        "expression": {
                                            "and": [
                                                {
                                                    "equals": [
                                                        "@toLower(items('FOREACH_Document')?['digest'])",
                                                        "@toLower(body('BLOB_Download_From_Staging')?['metadata']?['partnerdigest'])"
                                                    ]
                                                }
                                            ]
                                        },
                                        "actions": {
                                            "IF_Requires_Immutable_Record": {
                                                "type": "If",
                                                "expression": {
                                                    "and": [
                                                        {
                                                            "equals": [
                                                                "@toLower(body('TABLES_Get_Workload_By_ID')?['entities']?[0]?['SourceType'])",
                                                                "partner_api"
                                                            ]
                                                        }
                                                    ]
                                                },
                                                "actions": {
                                                    "BLOB_Upload_To_Records": {
                                                        "type": "ServiceProvider",
                                                        "inputs": {
                                                            "parameters": {
                                                                "containerName": "@appsetting('blob_records_container')",
                                                                "blobName": "@{concat('incoming/', items('FOREACH_Document')?['stagingBlobPath'])}",
                                                                "content": "@body('BLOB_Download_From_Staging')",
                                                                "overwrite": false
                                                            },
                                                            "serviceProviderConfiguration": {
                                                                "connectionName": "azureBlob",
                                                                "operationId": "uploadBlob",
                                                                "serviceProviderId": "/serviceProviders/AzureBlob"
                                                            }
                                                        }
                                                    }
                                                },
                                                "else": {
                                                    "actions": {}
                                                }
                                            },
                                            "FOREACH_Routing": {
                                                "type": "Foreach",
                                                "foreach": "@body('TABLES_Get_Enabled_Document_Routings_For_Workload')?['entities']",
                                                "actions": {
                                                    "SCOPE_Try_Routing": {
                                                        "type": "Scope",
                                                        "actions": {
                                                            "SET_Upload_Result_Empty": {
                                                                "type": "SetVariable",
                                                                "inputs": {
                                                                    "name": "activityUploadResult",
                                                                    "value": {}
                                                                }
                                                            },
                                                            "TABLES_Upsert_Document_Delivery_InProgress": {
                                                                "type": "ServiceProvider",
                                                                "inputs": {
                                                                    "parameters": {
                                                                        "tableName": "DtsDocumentDeliveries",
                                                                        "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                        "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                        "entity": {
                                                                            "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                            "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                            "WorkloadId": "@triggerBody()?['workloadId']",
                                                                            "ExternalRiskId": "@triggerBody()?['externalId']",
                                                                            "ExternalDocumentId": "@items('FOREACH_Document')?['documentId']",
                                                                            "ExternalRevision": "@items('FOREACH_Document')?['revision']",
                                                                            "DestinationConfigCode": "@items('FOREACH_Routing')?['DestinationConfigCode']",
                                                                            "DestinationType": "@items('FOREACH_Routing')?['DestinationType']",
                                                                            "Status": "InProgress",
                                                                            "AttemptCount": 1,
                                                                            "LastAttemptUtc": "@utcNow()"
                                                                        }
                                                                    },
                                                                    "serviceProviderConfiguration": {
                                                                        "connectionName": "azureTables",
                                                                        "operationId": "upsertEntity",
                                                                        "serviceProviderId": "/serviceProviders/AzureTables"
                                                                    }
                                                                },
                                                                "runAfter": {
                                                                    "SET_Upload_Result_Empty": [
                                                                        "Succeeded"
                                                                    ]
                                                                }
                                                            },
                                                            "COMPOSE_Upload_Request": {
                                                                "type": "Compose",
                                                                "inputs": {
                                                                    "function": "UploadDocumentFromPath",
                                                                    "configCode": "@items('FOREACH_Routing')?['DestinationConfigCode']",
                                                                    "stagingBlobPath": "@items('FOREACH_Document')?['stagingBlobPath']",
                                                                    "targetFolderPath": "@{concat(items('FOREACH_Routing')?['DestinationPath'], '/', body('TABLES_Get_Recorded_Risk_For_Workload')?['entities']?[0]?['RelativeFolderPath'])}",
                                                                    "fileName": "@items('FOREACH_Document')?['fileName']",
                                                                    "contentType": "@coalesce(items('FOREACH_Document')?['contentType'], 'application/octet-stream')",
                                                                    "correlationId": "@variables('correlationId')"
                                                                },
                                                                "runAfter": {
                                                                    "TABLES_Upsert_Document_Delivery_InProgress": [
                                                                        "Succeeded"
                                                                    ]
                                                                }
                                                            },
                                                            "SWITCH_Destination_Type": {
                                                                "type": "Switch",
                                                                "expression": "@items('FOREACH_Routing')?['DestinationType']",
                                                                "default": {
                                                                    "actions": {
                                                                        "TABLES_Upsert_Document_Delivery_Skipped": {
                                                                            "type": "ServiceProvider",
                                                                            "inputs": {
                                                                                "parameters": {
                                                                                    "tableName": "DtsDocumentDeliveries",
                                                                                    "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                                    "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                                    "entity": {
                                                                                        "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                                        "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                                        "Status": "Skipped",
                                                                                        "ReasonCode": "@{concat('UNSUPPORTED_TYPE:', items('FOREACH_Routing')?['DestinationType'])}",
                                                                                        "LastAttemptUtc": "@utcNow()"
                                                                                    }
                                                                                },
                                                                                "serviceProviderConfiguration": {
                                                                                    "connectionName": "azureTables",
                                                                                    "operationId": "upsertEntity",
                                                                                    "serviceProviderId": "/serviceProviders/AzureTables"
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                },
                                                                "cases": {
                                                                    "SharePoint": {
                                                                        "actions": {
                                                                            "WORKFLOW_Upload_SharePoint": {
                                                                                "type": "Workflow",
                                                                                "inputs": {
                                                                                    "host": {
                                                                                        "workflow": {
                                                                                            "id": "wf-activity-sharepoint"
                                                                                        }
                                                                                    },
                                                                                    "method": "POST",
                                                                                    "body": "@outputs('COMPOSE_Upload_Request')"
                                                                                }
                                                                            },
                                                                            "SET_Upload_Result_SP": {
                                                                                "type": "SetVariable",
                                                                                "inputs": {
                                                                                    "name": "activityUploadResult",
                                                                                    "value": "@body('WORKFLOW_Upload_SharePoint')?['body']"
                                                                                },
                                                                                "runAfter": {
                                                                                    "WORKFLOW_Upload_SharePoint": [
                                                                                        "Succeeded"
                                                                                    ]
                                                                                }
                                                                            }
                                                                        },
                                                                        "case": "SharePoint"
                                                                    },
                                                                    "NetworkShareDrive": {
                                                                        "actions": {
                                                                            "WORKFLOW_Upload_NetworkShareDrive": {
                                                                                "type": "Workflow",
                                                                                "inputs": {
                                                                                    "host": {
                                                                                        "workflow": {
                                                                                            "id": "wf-activity-network-share-drive"
                                                                                        }
                                                                                    },
                                                                                    "method": "POST",
                                                                                    "body": "@outputs('COMPOSE_Upload_Request')"
                                                                                }
                                                                            },
                                                                            "SET_Upload_Result_NSD": {
                                                                                "type": "SetVariable",
                                                                                "inputs": {
                                                                                    "name": "activityUploadResult",
                                                                                    "value": "@body('WORKFLOW_Upload_NetworkShareDrive')?['body']"
                                                                                },
                                                                                "runAfter": {
                                                                                    "WORKFLOW_Upload_NetworkShareDrive": [
                                                                                        "Succeeded"
                                                                                    ]
                                                                                }
                                                                            }
                                                                        },
                                                                        "case": "NetworkShareDrive"
                                                                    },
                                                                    "BlobStorage": {
                                                                        "actions": {
                                                                            "WORKFLOW_Upload_BlobStorage": {
                                                                                "type": "Workflow",
                                                                                "inputs": {
                                                                                    "host": {
                                                                                        "workflow": {
                                                                                            "id": "wf-activity-blob-storage"
                                                                                        }
                                                                                    },
                                                                                    "method": "POST",
                                                                                    "body": "@outputs('COMPOSE_Upload_Request')"
                                                                                }
                                                                            },
                                                                            "SET_Upload_Result_Blob": {
                                                                                "type": "SetVariable",
                                                                                "inputs": {
                                                                                    "name": "activityUploadResult",
                                                                                    "value": "@body('WORKFLOW_Upload_BlobStorage')?['body']"
                                                                                },
                                                                                "runAfter": {
                                                                                    "WORKFLOW_Upload_BlobStorage": [
                                                                                        "Succeeded"
                                                                                    ]
                                                                                }
                                                                            }
                                                                        },
                                                                        "case": "BlobStorage"
                                                                    },
                                                                    "PartnerApi": {
                                                                        "actions": {
                                                                            "WORKFLOW_Upload_PartnerApi": {
                                                                                "type": "Workflow",
                                                                                "inputs": {
                                                                                    "host": {
                                                                                        "workflow": {
                                                                                            "id": "wf-activity-partner-api"
                                                                                        }
                                                                                    },
                                                                                    "method": "POST",
                                                                                    "body": "@outputs('COMPOSE_Upload_Request')"
                                                                                }
                                                                            },
                                                                            "SET_Upload_Result_PA": {
                                                                                "type": "SetVariable",
                                                                                "inputs": {
                                                                                    "name": "activityUploadResult",
                                                                                    "value": "@body('WORKFLOW_Upload_PartnerApi')?['body']"
                                                                                },
                                                                                "runAfter": {
                                                                                    "WORKFLOW_Upload_PartnerApi": [
                                                                                        "Succeeded"
                                                                                    ]
                                                                                }
                                                                            },
                                                                            "BLOB_Upload_Outgoing_Record": {
                                                                                "type": "ServiceProvider",
                                                                                "inputs": {
                                                                                    "parameters": {
                                                                                        "containerName": "@appsetting('blob_records_container')",
                                                                                        "blobName": "@{concat('outgoing/', items('FOREACH_Document')?['stagingBlobPath'])}",
                                                                                        "content": "@body('BLOB_Download_From_Staging')",
                                                                                        "overwrite": false
                                                                                    },
                                                                                    "serviceProviderConfiguration": {
                                                                                        "connectionName": "azureBlob",
                                                                                        "operationId": "uploadBlob",
                                                                                        "serviceProviderId": "/serviceProviders/AzureBlob"
                                                                                    }
                                                                                },
                                                                                "runAfter": {
                                                                                    "SET_Upload_Result_PA": [
                                                                                        "Succeeded"
                                                                                    ]
                                                                                }
                                                                            }
                                                                        },
                                                                        "case": "PartnerApi"
                                                                    }
                                                                },
                                                                "runAfter": {
                                                                    "COMPOSE_Upload_Request": [
                                                                        "Succeeded"
                                                                    ]
                                                                }
                                                            },
                                                            "IF_Upload_Succeeded": {
                                                                "type": "If",
                                                                "expression": {
                                                                    "and": [
                                                                        {
                                                                            "greater": [
                                                                                "@length(variables('activityUploadResult'))",
                                                                                0
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                "actions": {
                                                                    "TABLES_Update_Document_Published": {
                                                                        "type": "ServiceProvider",
                                                                        "inputs": {
                                                                            "parameters": {
                                                                                "tableName": "DtsDocuments",
                                                                                "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                                "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'])}",
                                                                                "entity": {
                                                                                    "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                                    "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'])}",
                                                                                    "Status": "Published",
                                                                                    "RecordBlobPath": "@items('FOREACH_Document')?['stagingBlobPath']",
                                                                                    "SharePointFileUrl": "@variables('activityUploadResult')?['targetPath']",
                                                                                    "DeliveredFileName": "@items('FOREACH_Document')?['fileName']",
                                                                                    "PublishedAtUtc": "@utcNow()"
                                                                                }
                                                                            },
                                                                            "serviceProviderConfiguration": {
                                                                                "connectionName": "azureTables",
                                                                                "operationId": "upsertEntity",
                                                                                "serviceProviderId": "/serviceProviders/AzureTables"
                                                                            }
                                                                        }
                                                                    },
                                                                    "TABLES_Upsert_Document_Delivery_Delivered": {
                                                                        "type": "ServiceProvider",
                                                                        "inputs": {
                                                                            "parameters": {
                                                                                "tableName": "DtsDocumentDeliveries",
                                                                                "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                                "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                                "entity": {
                                                                                    "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                                    "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                                    "Status": "Delivered",
                                                                                    "TargetPath": "@variables('activityUploadResult')?['targetPath']",
                                                                                    "TargetETag": "@variables('activityUploadResult')?['targetETag']",
                                                                                    "DeliveredUtc": "@utcNow()",
                                                                                    "LastAttemptUtc": "@utcNow()"
                                                                                }
                                                                            },
                                                                            "serviceProviderConfiguration": {
                                                                                "connectionName": "azureTables",
                                                                                "operationId": "upsertEntity",
                                                                                "serviceProviderId": "/serviceProviders/AzureTables"
                                                                            }
                                                                        },
                                                                        "runAfter": {
                                                                            "TABLES_Update_Document_Published": [
                                                                                "Succeeded"
                                                                            ]
                                                                        }
                                                                    }
                                                                },
                                                                "else": {
                                                                    "actions": {}
                                                                },
                                                                "runAfter": {
                                                                    "SWITCH_Destination_Type": [
                                                                        "Succeeded"
                                                                    ]
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "SCOPE_Catch_Routing": {
                                                        "type": "Scope",
                                                        "actions": {
                                                            "TABLES_Upsert_Document_Delivery_Failed": {
                                                                "type": "ServiceProvider",
                                                                "inputs": {
                                                                    "parameters": {
                                                                        "tableName": "DtsDocumentDeliveries",
                                                                        "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                        "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                        "entity": {
                                                                            "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                            "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '|', items('FOREACH_Routing')?['DestinationConfigCode'])}",
                                                                            "Status": "Failed",
                                                                            "ReasonCode": "UPLOAD_ERROR",
                                                                            "LastAttemptUtc": "@utcNow()"
                                                                        }
                                                                    },
                                                                    "serviceProviderConfiguration": {
                                                                        "connectionName": "azureTables",
                                                                        "operationId": "upsertEntity",
                                                                        "serviceProviderId": "/serviceProviders/AzureTables"
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "runAfter": {
                                                            "SCOPE_Try_Routing": [
                                                                "Failed",
                                                                "TimedOut",
                                                                "Skipped"
                                                            ]
                                                        }
                                                    }
                                                },
                                                "runAfter": {
                                                    "IF_Requires_Immutable_Record": [
                                                        "Succeeded"
                                                    ]
                                                },
                                                "runtimeConfiguration": {
                                                    "concurrency": {
                                                        "repetitions": 1
                                                    }
                                                }
                                            },
                                            "INCREMENT_DeliveredCount": {
                                                "type": "IncrementVariable",
                                                "inputs": {
                                                    "name": "deliveredCount",
                                                    "value": 1
                                                },
                                                "runAfter": {
                                                    "FOREACH_Routing": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            }
                                        },
                                        "else": {
                                            "actions": {
                                                "COMPOSE_Quarantine_Blob_Name": {
                                                    "type": "Compose",
                                                    "inputs": "@{concat('quarantine/', triggerBody()?['externalId'], '/', items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'], '-', utcNow('yyyyMMddHHmmss'))}"
                                                },
                                                "BLOB_Upload_To_Quarantine": {
                                                    "type": "ServiceProvider",
                                                    "inputs": {
                                                        "parameters": {
                                                            "containerName": "@appsetting('blob_quarantine_container')",
                                                            "blobName": "@outputs('COMPOSE_Quarantine_Blob_Name')",
                                                            "content": "@body('BLOB_Download_From_Staging')",
                                                            "overwrite": false
                                                        },
                                                        "serviceProviderConfiguration": {
                                                            "connectionName": "azureBlob",
                                                            "operationId": "uploadBlob",
                                                            "serviceProviderId": "/serviceProviders/AzureBlob"
                                                        }
                                                    },
                                                    "runAfter": {
                                                        "COMPOSE_Quarantine_Blob_Name": [
                                                            "Succeeded"
                                                        ]
                                                    }
                                                },
                                                "TABLES_Update_Document_Failed_Hash": {
                                                    "type": "ServiceProvider",
                                                    "inputs": {
                                                        "parameters": {
                                                            "tableName": "DtsDocuments",
                                                            "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                            "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'])}",
                                                            "entity": {
                                                                "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                                "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'])}",
                                                                "Status": "Failed",
                                                                "QuarantineBlobPath": "@outputs('COMPOSE_Quarantine_Blob_Name')",
                                                                "FailedReason": "HASH_MISMATCH",
                                                                "FailedAtUtc": "@utcNow()"
                                                            }
                                                        },
                                                        "serviceProviderConfiguration": {
                                                            "connectionName": "azureTables",
                                                            "operationId": "upsertEntity",
                                                            "serviceProviderId": "/serviceProviders/AzureTables"
                                                        }
                                                    },
                                                    "runAfter": {
                                                        "BLOB_Upload_To_Quarantine": [
                                                            "Succeeded",
                                                            "Failed"
                                                        ]
                                                    }
                                                },
                                                "INCREMENT_FailedCount_Hash": {
                                                    "type": "IncrementVariable",
                                                    "inputs": {
                                                        "name": "failedCount",
                                                        "value": 1
                                                    },
                                                    "runAfter": {
                                                        "TABLES_Update_Document_Failed_Hash": [
                                                            "Succeeded",
                                                            "Failed"
                                                        ]
                                                    }
                                                },
                                                "HTTP_Track_Hash_Mismatch_Event": {
                                                    "type": "Http",
                                                    "inputs": {
                                                        "uri": "https://dc.services.visualstudio.com/v2/track",
                                                        "method": "POST",
                                                        "body": {
                                                            "name": "Microsoft.ApplicationInsights.Event",
                                                            "time": "@utcNow()",
                                                            "iKey": "@appsetting('appinsights_instrumentation_key')",
                                                            "data": {
                                                                "baseType": "EventData",
                                                                "baseData": {
                                                                    "ver": 2,
                                                                    "name": "DTS_DocumentHashMismatch",
                                                                    "properties": {
                                                                        "workloadId": "@{triggerBody()?['workloadId']}",
                                                                        "correlationId": "@{triggerBody()?['correlationId']}",
                                                                        "externalId": "@{triggerBody()?['externalId']}",
                                                                        "documentId": "@{items('FOREACH_Document')?['documentId']}"
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "retryPolicy": {
                                                            "type": "none"
                                                        }
                                                    },
                                                    "runAfter": {
                                                        "INCREMENT_FailedCount_Hash": [
                                                            "Succeeded",
                                                            "Failed"
                                                        ]
                                                    }
                                                }
                                            }
                                        },
                                        "runAfter": {
                                            "BLOB_Download_From_Staging": [
                                                "Succeeded"
                                            ]
                                        }
                                    }
                                }
                            },
                            "SCOPE_Catch": {
                                "type": "Scope",
                                "actions": {
                                    "TABLES_Update_Document_Error": {
                                        "type": "ServiceProvider",
                                        "inputs": {
                                            "parameters": {
                                                "tableName": "DtsDocuments",
                                                "partitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                "rowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'])}",
                                                "entity": {
                                                    "PartitionKey": "@{concat(triggerBody()?['workloadId'], '|', triggerBody()?['externalId'])}",
                                                    "RowKey": "@{concat(items('FOREACH_Document')?['documentId'], '|', items('FOREACH_Document')?['revision'])}",
                                                    "Status": "Failed",
                                                    "FailedReason": "PROCESSING_ERROR",
                                                    "FailedAtUtc": "@utcNow()"
                                                }
                                            },
                                            "serviceProviderConfiguration": {
                                                "connectionName": "azureTables",
                                                "operationId": "upsertEntity",
                                                "serviceProviderId": "/serviceProviders/AzureTables"
                                            }
                                        }
                                    },
                                    "INCREMENT_FailedCount_Catch": {
                                        "type": "IncrementVariable",
                                        "inputs": {
                                            "name": "failedCount",
                                            "value": 1
                                        },
                                        "runAfter": {
                                            "TABLES_Update_Document_Error": [
                                                "Succeeded",
                                                "Failed"
                                            ]
                                        }
                                    },
                                    "HTTP_Track_Processing_Error_Event": {
                                        "type": "Http",
                                        "inputs": {
                                            "uri": "https://dc.services.visualstudio.com/v2/track",
                                            "method": "POST",
                                            "body": {
                                                "name": "Microsoft.ApplicationInsights.Event",
                                                "time": "@utcNow()",
                                                "iKey": "@appsetting('appinsights_instrumentation_key')",
                                                "data": {
                                                    "baseType": "EventData",
                                                    "baseData": {
                                                        "ver": 2,
                                                        "name": "DTS_DocumentProcessingError",
                                                        "properties": {
                                                            "workloadId": "@{triggerBody()?['workloadId']}",
                                                            "correlationId": "@{triggerBody()?['correlationId']}",
                                                            "externalId": "@{triggerBody()?['externalId']}",
                                                            "documentId": "@{items('FOREACH_Document')?['documentId']}",
                                                            "error": "@{result('SCOPE_Try')?[0]?['error']?['message']}"
                                                        }
                                                    }
                                                }
                                            },
                                            "retryPolicy": {
                                                "type": "none"
                                            }
                                        },
                                        "runAfter": {
                                            "INCREMENT_FailedCount_Catch": [
                                                "Succeeded",
                                                "Failed"
                                            ]
                                        }
                                    }
                                },
                                "runAfter": {
                                    "SCOPE_Try": [
                                        "Failed",
                                        "TimedOut",
                                        "Skipped"
                                    ]
                                }
                            }
                        },
                        "runtimeConfiguration": {
                            "concurrency": {
                                "repetitions": 1
                            }
                        }
                    },
                    "TABLES_Get_Published_Documents": {
                        "type": "ServiceProvider",
                        "inputs": {
                            "parameters": {
                                "tableName": "DtsDocuments",
                                "filterQuery": "@{concat('PartitionKey eq ''', triggerBody()?['workloadId'], '|', triggerBody()?['externalId'], ''' and Status eq ''Published''')}"
                            },
                            "serviceProviderConfiguration": {
                                "connectionName": "azureTables",
                                "operationId": "queryEntities",
                                "serviceProviderId": "/serviceProviders/AzureTables"
                            }
                        },
                        "runAfter": {
                            "FOREACH_Document": [
                                "Succeeded",
                                "Failed"
                            ]
                        }
                    },
                    "IF_Notification_Enabled": {
                        "type": "If",
                        "expression": {
                            "and": [
                                {
                                    "equals": [
                                        "@coalesce(triggerBody()?['enableNotification'], false)",
                                        true
                                    ]
                                },
                                {
                                    "not": {
                                        "equals": [
                                            "@empty(coalesce(triggerBody()?['notificationType'], ''))",
                                            true
                                        ]
                                    }
                                },
                                {
                                    "or": [
                                        {
                                            "and": [
                                                {
                                                    "equals": [
                                                        "@coalesce(triggerBody()?['notifyOnErrorsOnly'], true)",
                                                        true
                                                    ]
                                                },
                                                {
                                                    "greater": [
                                                        "@variables('failedCount')",
                                                        0
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "and": [
                                                {
                                                    "equals": [
                                                        "@coalesce(triggerBody()?['notifyOnErrorsOnly'], true)",
                                                        false
                                                    ]
                                                },
                                                {
                                                    "greater": [
                                                        "@add(variables('deliveredCount'), variables('failedCount'))",
                                                        0
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        "actions": {
                            "SB_Publish_Notification_Request": {
                                "type": "ServiceProvider",
                                "inputs": {
                                    "parameters": {
                                        "entityName": "@appsetting('sbus_topic_notifications')",
                                        "message": {
                                            "contentData": {
                                                "notificationType": "@triggerBody()?['notificationType']",
                                                "notificationRecipient": "@triggerBody()?['notificationRecipient']",
                                                "workloadId": "@triggerBody()?['workloadId']",
                                                "partnerExternalId": "@triggerBody()?['externalId']",
                                                "documents": "@coalesce(body('TABLES_Get_Published_Documents')?['entities'], createArray())",
                                                "partnerId": "@triggerBody()?['partnerId']",
                                                "hasErrors": "@greater(variables('failedCount'), 0)",
                                                "attachmentsMode": "FileLinks",
                                                "correlationId": "@variables('correlationId')"
                                            },
                                            "contentType": "application/json",
                                            "userProperties": {
                                                "workloadId": "@triggerBody()?['workloadId']",
                                                "notificationType": "@triggerBody()?['notificationType']"
                                            },
                                            "messageId": "@{concat(triggerBody()?['workloadId'], '-', triggerBody()?['externalId'], '-notif-', utcNow('yyyyMMddHHmm'))}"
                                        }
                                    },
                                    "serviceProviderConfiguration": {
                                        "connectionName": "serviceBus",
                                        "operationId": "sendMessage",
                                        "serviceProviderId": "/serviceProviders/serviceBus"
                                    }
                                }
                            }
                        },
                        "else": {
                            "actions": {}
                        },
                        "runAfter": {
                            "TABLES_Get_Published_Documents": [
                                "Succeeded",
                                "Failed"
                            ]
                        }
                    }
                },
                "else": {
                    "actions": {
                        "HTTP_Track_Entity_Not_Found_Event": {
                            "type": "Http",
                            "inputs": {
                                "uri": "https://dc.services.visualstudio.com/v2/track",
                                "method": "POST",
                                "body": {
                                    "name": "Microsoft.ApplicationInsights.Event",
                                    "time": "@utcNow()",
                                    "iKey": "@appsetting('appinsights_instrumentation_key')",
                                    "data": {
                                        "baseType": "EventData",
                                        "baseData": {
                                            "ver": 2,
                                            "name": "DTS_DeliveryEntityNotFound",
                                            "properties": {
                                                "workloadId": "@{triggerBody()?['workloadId']}",
                                                "correlationId": "@{triggerBody()?['correlationId']}",
                                                "externalId": "@{triggerBody()?['externalId']}"
                                            }
                                        }
                                    }
                                },
                                "retryPolicy": {
                                    "type": "none"
                                }
                            }
                        }
                    }
                },
                "runAfter": {
                    "TABLES_Get_Workload_By_ID": [
                        "Succeeded"
                    ],
                    "TABLES_Get_Enabled_Document_Routings_For_Workload": [
                        "Succeeded"
                    ],
                    "TABLES_Get_Recorded_Risk_For_Workload": [
                        "Succeeded"
                    ]
                }
            },
            "Response": {
                "type": "Response",
                "inputs": {
                    "statusCode": "@if(greater(variables('failedCount'), 0), 500, 200)",
                    "body": {
                        "workloadId": "@triggerBody()?['workloadId']",
                        "externalId": "@triggerBody()?['externalId']",
                        "deliveredCount": "@variables('deliveredCount')",
                        "failedCount": "@variables('failedCount')"
                    }
                },
                "runAfter": {
                    "IF_Datastore_Entities_Are_Valid": [
                        "Succeeded",
                        "Failed"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "Stateful"
}

{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "HTTP_Trigger": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": ["function", "configCode", "correlationId"],
            "properties": {
              "function":         { "type": "string", "enum": ["GetDocumentsMetadata", "DownloadDocumentToStaging", "UploadDocumentFromPath"] },
              "configCode":       { "type": "string", "description": "SourceConfigCode (source functions) or DestinationConfigCode (upload function). Used as app settings prefix." },
              "workloadId":     { "type": "string" },
              "externalId":           { "type": "string" },
              "documentId":       { "type": "string" },
              "revision":         { "type": "string" },
              "fileName":         { "type": "string" },
              "contentType":      { "type": "string" },
              "stagingBlobPath":  { "type": "string", "description": "Required for UploadDocumentFromPath." },
              "targetFolderPath": { "type": "string", "description": "Risk relative folder path for destination. Required for UploadDocumentFromPath." },
              "watermarkFrom":    { "type": "string" },
              "nextKey":          { "type": "string" },
              "correlationId":    { "type": "string" }
            }
          }
        }
      }
    },
    "actions": {

      "INIT_Variables": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name":  "correlationId",
              "type":  "string",
              "value": "@coalesce(triggerOutputs()?['headers']?[appsetting('correlation_id_header')], triggerBody()?['correlationId'], '')"
            }
          ]
        }
      },

      "IF_Assert_CorrelationId_Consistent": {
        "type": "If",
        "runAfter": { "INIT_Variables": ["Succeeded"] },
        "expression": {
          "and": [
            { "not": { "empty": ["@coalesce(triggerOutputs()?['headers']?[appsetting('correlation_id_header')], '')"] } },
            { "not": { "empty": ["@coalesce(triggerBody()?['correlationId'], '')"] } },
            { "not": { "equals": ["@triggerOutputs()?['headers']?[appsetting('correlation_id_header')]", "@triggerBody()?['correlationId']"] } }
          ]
        },
        "actions": {
          "Response_CorrelationId_Mismatch": {
            "type": "Response",
            "runAfter": {},
            "inputs": {
              "statusCode": 400,
              "body": { "error": "correlationId in request header and body must match when both are provided" }
            }
          },
          "Terminate_CorrelationId_Mismatch": {
            "type": "Terminate",
            "runAfter": { "Response_CorrelationId_Mismatch": ["Succeeded"] },
            "inputs": {
              "runStatus": "Failed",
              "runError": { "code": "CorrelationIdMismatch", "message": "correlationId header and body values differ" }
            }
          }
        },
        "else": { "actions": {} }
      },

      "SWITCH_Function": {
        "type": "Switch",
        "expression": "@triggerBody()?['function']",
        "runAfter": { "IF_Assert_CorrelationId_Consistent": ["Succeeded"] },
        "cases": {

          "GetDocumentsMetadata": {
            "case": "GetDocumentsMetadata",
            "actions": {
              "Response_GetMetadata_NotImplemented": {
                "type": "Response",
                "inputs": {
                  "statusCode": 501,
                  "body": { "error": "SharePoint GetDocumentsMetadata not yet implemented." }
                },
                "runAfter": {}
              }
            }
          },

          "DownloadDocumentToStaging": {
            "case": "DownloadDocumentToStaging",
            "actions": {
              "Response_Download_NotImplemented": {
                "type": "Response",
                "inputs": {
                  "statusCode": 501,
                  "body": { "error": "SharePoint DownloadDocumentToStaging not yet implemented." }
                },
                "runAfter": {}
              }
            }
          },

          "UploadDocumentFromPath": {
            "case": "UploadDocumentFromPath",
            "actions": {

              "COMPOSE_Drive_Id": {
                "type": "Compose",
                "inputs": "@if(empty(trim(coalesce(triggerBody()?['configCode'], '')), appsetting('sharepoint_site_drive_id'), coalesce(appsetting(concat(triggerBody()?['configCode'], '::sharepoint_site_drive_id')), appsetting('sharepoint_site_drive_id')))",
                "runAfter": {}
              },

              "BLOB_Download_From_Staging": {
                "type": "ServiceProvider",
                "runAfter": { "COMPOSE_Drive_Id": ["Succeeded"] },
                "inputs": {
                  "parameters": {
                    "containerName": "@appsetting('blob_staging_container')",
                    "blobName":      "@triggerBody()?['stagingBlobPath']"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName":    "azureBlob",
                    "operationId":       "readBlob",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                }
              },

              "COMPOSE_SP_Upload_Uri": {
                "type": "Compose",
                "runAfter": { "BLOB_Download_From_Staging": ["Succeeded"] },
                "inputs": "@{concat('https://graph.microsoft.com/v1.0/drives/', outputs('COMPOSE_Drive_Id'), '/root:/', triggerBody()?['targetFolderPath'], '/', triggerBody()?['fileName'], ':/content')}"
              },

              "HTTP_Upload_To_SharePoint": {
                "type": "Http",
                "runAfter": { "COMPOSE_SP_Upload_Uri": ["Succeeded"] },
                "inputs": {
                  "method":  "PUT",
                  "uri":     "@outputs('COMPOSE_SP_Upload_Uri')",
                  "headers": {
                    "Content-Type": "@coalesce(triggerBody()?['contentType'], 'application/octet-stream')"
                  },
                  "body": "@body('BLOB_Download_From_Staging')?['content']",
                  "authentication": {
                    "type":     "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com"
                  },
                  "retryPolicy": { "type": "exponential", "count": 4, "interval": "PT15S", "maximumInterval": "PT2M" }
                }
              },

              "Response_Upload": {
                "type": "Response",
                "runAfter": { "HTTP_Upload_To_SharePoint": ["Succeeded"] },
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "targetPath": "@body('HTTP_Upload_To_SharePoint')?['webUrl']",
                    "targetETag": "@body('HTTP_Upload_To_SharePoint')?['eTag']"
                  }
                }
              },

              "Response_Upload_Error": {
                "type": "Response",
                "runAfter": {
                  "BLOB_Download_From_Staging": ["Failed"],
                  "HTTP_Upload_To_SharePoint":  ["Failed", "TimedOut"]
                },
                "inputs": {
                  "statusCode": 500,
                  "body": {
                    "error":        "UploadDocumentFromPath failed",
                    "stagingPath":  "@triggerBody()?['stagingBlobPath']",
                    "targetFolder": "@triggerBody()?['targetFolderPath']",
                    "fileName":     "@triggerBody()?['fileName']"
                  }
                }
              }

            }
          }

        },
        "default": {
          "actions": {
            "Response_Unsupported_Function": {
              "type": "Response",
              "inputs": {
                "statusCode": 400,
                "body": { "error": "@{concat('Unsupported function: ', triggerBody()?['function'])}" }
              },
              "runAfter": {}
            }
          }
        }
      }

    },
    "outputs": {}
  },
  "kind": "Stateful"
}

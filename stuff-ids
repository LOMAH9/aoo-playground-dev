                                            },
                                            "FOREACH_Doc_Filter": {
                                                "type": "Foreach",
                                                "foreach": "@coalesce(items('FOREACH_Page_Risk')?['docs'], createArray())",
                                                "actions": {
                                                    "IF_Doc_Matches_Filters": {
                                                        "type": "If",
                                                        "expression": {
                                                            "and": [
                                                                {
                                                                    "or": [
                                                                        {
                                                                            "empty": [
                                                                                "@coalesce(triggerBody()?['filters']?['extDocStatusesCsv'], '')"

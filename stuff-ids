                            },
                            "Response_GetDocumentsMetadata": {
                                "type": "Response",
                                "inputs": {
                                    "statusCode": 200,
                                    "body": "@outputs('COMPOSE_GetDocumentsMetadata_Response')"
                                },
                                "runAfter": {
                                    "COMPOSE_GetDocumentsMetadata_Response": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "Response_GetDocumentsMetadata_Error": {
                                "type": "Response",
                                "inputs": {

                                                "Succeeded"
                                            ]
                                        },
                                        "operationOptions": "Sequential"
                                    },
                                    "SET_More_Pages": {
                                        "type": "SetVariable",
                                        "inputs": {
                                            "name": "pageMoreItems",
                                            "value": "@and(equals(length(body('PARSE_Page_Result')), 60), greaterOrEquals(ticks(last(body('PARSE_Page_Result'))?['updatedAt']), ticks(coalesce(triggerBody()?['watermarkFrom'], '2000-01-01T00:00:00Z'))))"

                                                            "type": "string"
                                                        },
                                                        "status": {
                                                            "type": "string"
                                                        },
                                                        "docs": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "id": {
                                                                        "type": "string"
                                                                    },
                                                                    "umr": {
                                                                        "type": "string"
                                                                    },
                                                                    "insuredName": {
                                                                        "type": "string"
                                                                    },
                                                                    "inceptionDate": {
                                                                        "type": "string"
                                                                    },
                                                                    "type": {
                                                                        "type": "string"
                                                                    },
                                                                    "rev": {
                                                                        "type": "string"
                                                                    },
                                                                    "placementType": {
                                                                        "type": "string"
                                                                    },
                                                                    "status": {
                                                                        "type": "string"
                                                                    },
                                                                    "lastUpdatedAt": {
                                                                        "type": "string"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "runAfter": {
                                            "HTTP_Get_Risks_Summary_Page": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "IF_Set_Watermark_Initial": {
                                        "type": "If",
                                        "expression": {
                                            "and": [
                                                {
                                                    "equals": [
                                                        "@variables('pagesReadCount')",
                                                        0
                                                    ]
                                                },
                                                {
                                                    "greater": [
                                                        "@length(body('PARSE_Page_Result'))",
                                                        0
                                                    ]
                                                }
                                            ]
                                        },
                                        "actions": {
                                            "SET_WatermarkTo_Initial": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "watermarkToInternal",
                                                    "value": "@first(body('PARSE_Page_Result'))?['updatedAt']"
                                                }
                                            }
                                        },
                                        "else": {
                                            "actions": {}
                                        },
                                        "runAfter": {
                                            "PARSE_Page_Result": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "FOREACH_Page_Risk": {
                                        "type": "Foreach",
                                        "foreach": "@body('PARSE_Page_Result')",
                                        "actions": {
                                            "SET_Reset_CurrentDocuments": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "currentDocuments",
                                                    "value": []

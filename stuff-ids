"code": "const JSZip = require('jszip');\nconst body = workflowContext.actions.HTTP_Export_Pdf_Bundle.outputs.body;\nconst b64 = (body && body['$content']) ? body['$content'] : body;\nconst buf = Buffer.from(b64, 'base64');\nreturn (async () => {\n  const zip = await JSZip.loadAsync(buf);\n  const files = [];\n  const fileNames = Object.keys(zip.files);\n  for (let i = 0; i < fileNames.length; i++) {\n    const name = fileNames[i];\n    const entry = zip.files[name];\n    if (!entry.dir) {\n      const content = await entry.async('base64');\n      files.push({ name: name.replace(/^.*[\\/\\\\]/, ''), content: content, size: Buffer.from(content, 'base64').length });\n    }\n  }\n  return files;\n})();",

{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Recurrence": {
                "type": "Recurrence",
                "recurrence": {
                    "frequency": "Minute",
                    "interval": 5
                }
            }
        },
        "actions": {
            "INIT_Variables": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "nowUtc",
                            "type": "string",
                            "value": "@utcNow()"
                        }
                    ]
                },
                "runAfter": {}
            },
            "TABLES_Get_Bank_Holidays_Today": {
                "type": "ServiceProvider",
                "inputs": {
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/azureTables"
                    },
                    "parameters": {
                        "tableName": "DtsNonWorkingDays",
                        "filterQuery": "@{concat('PartitionKey eq ''england-and-wales'' and RowKey eq ''', formatDateTime(variables('nowUtc'), 'yyyy-MM-dd'), '''')}"
                    }
                },
                "runAfter": {
                    "INIT_Variables": [
                        "Succeeded"
                    ]
                }
            },
            "COMPOSE_Is_Bank_Holiday": {
                "type": "Compose",
                "inputs": "@greater(length(body('TABLES_Get_Bank_Holidays_Today')?['entities']), 0)",
                "runAfter": {
                    "TABLES_Get_Bank_Holidays_Today": [
                        "Succeeded"
                    ]
                }
            },
            "TABLES_Get_Enabled_Partners": {
                "type": "ServiceProvider",
                "inputs": {
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/azureTables"
                    },
                    "parameters": {
                        "tableName": "DtsPartners",
                        "filterQuery": "@{concat('IsEnabled eq true and ValidFromUtc le ''', variables('nowUtc'), ''' and ValidToUtc ge ''', variables('nowUtc'), '''')}"
                    }
                },
                "runAfter": {
                    "COMPOSE_Is_Bank_Holiday": [
                        "Succeeded"
                    ]
                }
            },
            "SELECT_Active_Partner_Codes": {
                "type": "Select",
                "inputs": {
                    "from": "@body('TABLES_Get_Enabled_Partners')?['entities']",
                    "select": "@item()?['PartitionKey']"
                },
                "runAfter": {
                    "TABLES_Get_Enabled_Partners": [
                        "Succeeded"
                    ]
                }
            },
            "COMPOSE_Active_Partner_Filter": {
                "type": "Compose",
                "inputs": "@{if(equals(length(body('SELECT_Active_Partner_Codes')), 0), 'IsEnabled eq true and IsPaused eq false and PartnerId eq ''__NONE__''', concat('IsEnabled eq true and IsPaused eq false and (PartnerId eq ''', join(body('SELECT_Active_Partner_Codes'), ''' or PartnerId eq '''), ''')')))}",
                "runAfter": {
                    "SELECT_Active_Partner_Codes": [
                        "Succeeded"
                    ]
                }
            },
            "TABLES_Get_Active_Workloads": {
                "type": "ServiceProvider",
                "inputs": {
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/azureTables"
                    },
                    "parameters": {
                        "tableName": "DtsWorkloads",
                        "filterQuery": "@outputs('COMPOSE_Active_Partner_Filter')"
                    }
                },
                "runAfter": {
                    "COMPOSE_Active_Partner_Filter": [
                        "Succeeded"
                    ]
                }
            },
            "SELECT_Active_Workload_Codes": {
                "type": "Select",
                "inputs": {
                    "from": "@body('TABLES_Get_Active_Workloads')?['entities']",
                    "select": "@item()?['PartitionKey']"
                },
                "runAfter": {
                    "TABLES_Get_Active_Workloads": [
                        "Succeeded"
                    ]
                }
            },
            "COMPOSE_Runtime_States_Query_Filter": {
                "type": "Compose",
                "inputs": "@{if(equals(length(body('SELECT_Active_Workload_Codes')), 0), 'PartitionKey eq ''__NONE__''', concat('(PartitionKey eq ''', join(body('SELECT_Active_Workload_Codes'), ''' or PartitionKey eq '''), ''')'))}" ,
                "runAfter": {
                    "SELECT_Active_Workload_Codes": [
                        "Succeeded"
                    ]
                }
            },
            "COMPOSE_Schedules_Query_Filter": {
                "type": "Compose",
                "inputs": "@{if(equals(length(body('SELECT_Active_Workload_Codes')), 0), 'PartitionKey eq ''__NONE__'' and IsEnabled eq true', concat('(PartitionKey eq ''', join(body('SELECT_Active_Workload_Codes'), ''' or PartitionKey eq '''), ''') and IsEnabled eq true and EffectiveFromUtc le ''', variables('nowUtc'), ''' and EffectiveToUtc ge ''', variables('nowUtc'), ''' and WindowStartTime le ''', formatDateTime(variables('nowUtc'), 'HH:mm'), ''' and WindowEndTime ge ''', formatDateTime(variables('nowUtc'), 'HH:mm'), ''''))}",
                "runAfter": {
                    "SELECT_Active_Workload_Codes": [
                        "Succeeded"
                    ]
                }
            },
            "TABLES_Get_Runtime_States_For_Active_Workloads": {
                "type": "ServiceProvider",
                "inputs": {
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/azureTables"
                    },
                    "parameters": {
                        "tableName": "DtsWorkloadRuntimeState",
                        "filterQuery": "@outputs('COMPOSE_Runtime_States_Query_Filter')"
                    }
                },
                "runAfter": {
                    "COMPOSE_Runtime_States_Query_Filter": [
                        "Succeeded"
                    ]
                }
            },
            "TABLES_Get_Schedules_For_Active_Workloads": {
                "type": "ServiceProvider",
                "inputs": {
                    "serviceProviderConfiguration": {
                        "connectionName": "azureTables",
                        "operationId": "queryEntities",
                        "serviceProviderId": "/serviceProviders/azureTables"
                    },
                    "parameters": {
                        "tableName": "DtsWorkloadSchedules",
                        "filterQuery": "@outputs('COMPOSE_Schedules_Query_Filter')"
                    }
                },
                "runAfter": {
                    "COMPOSE_Schedules_Query_Filter": [
                        "Succeeded"
                    ]
                }
            },
            "FOREACH_Workload": {
                "type": "Foreach",
                "foreach": "@body('TABLES_Get_Active_Workloads')?['entities']",
                "actions": {
                    "FILTER_RunTimeState_For_Current_Workload": {
                        "type": "Query",
                        "inputs": {
                            "from": "@body('TABLES_Get_Runtime_States_For_Active_Workloads')?['entities']",
                            "where": "@equals(item()?['PartitionKey'], items('FOREACH_Workload')?['PartitionKey'])"
                        }
                    },
                    "FILTER_Schedules_For_Current_Workload": {
                        "type": "Query",
                        "inputs": {
                            "from": "@body('TABLES_Get_Schedules_For_Active_Workloads')?['entities']",
                            "where": "@equals(item()?['PartitionKey'], items('FOREACH_Workload')?['PartitionKey'])"
                        },
                        "runAfter": {
                            "FILTER_RunTimeState_For_Current_Workload": [
                                "Succeeded"
                            ]
                        }
                    },
                    "IF_Workload_Is_Due": {
                        "type": "If",
                        "expression": {
                            "and": [
                                {
                                    "greaterOrEquals": [
                                        "@length(body('FILTER_Schedules_For_Current_Workload'))",
                                        1
                                    ]
                                },
                                {
                                    "not": {
                                        "equals": [
                                            "@coalesce(body('FILTER_RunTimeState_For_Current_Workload')?[0]?['LastStatus'], '')",
                                            "Running"
                                        ]
                                    }
                                },
                                {
                                    "or": [
                                        {
                                            "equals": [
                                                "@coalesce(items('FOREACH_Workload')?['RunOnBankHolidays'], true)",
                                                true
                                            ]
                                        },
                                        {
                                            "equals": [
                                                "@outputs('COMPOSE_Is_Bank_Holiday')",
                                                false
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "equals": [
                                        "@mod(div(int(coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['DaysOfWeekMask'], 0)), int(createArray(64,1,2,4,8,16,32)[dayOfWeek(convertTimeZone(variables('nowUtc'), 'UTC', coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['TimeZoneId'], 'UTC')))])), 2)",
                                        1
                                    ]
                                },
                                {
                                    "greaterOrEquals": [
                                        "@formatDateTime(convertTimeZone(variables('nowUtc'), 'UTC', coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['TimeZoneId'], 'UTC')), 'HH:mm')",
                                        "@coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['WindowStartTime'], '00:00')"
                                    ]
                                },
                                {
                                    "or": [
                                        {
                                            "equals": [
                                                "@coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['WindowEndTime'], '')",
                                                ""
                                            ]
                                        },
                                        {
                                            "lessOrEquals": [
                                                "@formatDateTime(convertTimeZone(variables('nowUtc'), 'UTC', coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['TimeZoneId'], 'UTC')), 'HH:mm')",
                                                "@body('FILTER_Schedules_For_Current_Workload')?[0]?['WindowEndTime']"
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "or": [
                                        {
                                            "and": [
                                                {
                                                    "greater": [
                                                        "@coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['IntervalHours'], 0)",
                                                        0
                                                    ]
                                                },
                                                {
                                                    "greaterOrEquals": [
                                                        "@variables('nowUtc')",
                                                        "@addHours(coalesce(body('FILTER_RunTimeState_For_Current_Workload')?[0]?['LastRunStartedUtc'], items('FOREACH_Workload')?['InitialWatermarkUtc']), float(coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['IntervalHours'], 0)))"
                                                    ]
                                                },
                                                {
                                                    "lessOrEquals": [
                                                        "@variables('nowUtc')",
                                                        "@addMinutes(addHours(coalesce(body('FILTER_RunTimeState_For_Current_Workload')?[0]?['LastRunStartedUtc'], items('FOREACH_Workload')?['InitialWatermarkUtc']), float(coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['IntervalHours'], 0))), 30)"
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "and": [
                                                {
                                                    "lessOrEquals": [
                                                        "@coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['IntervalHours'], 0)",
                                                        0
                                                    ]
                                                },
                                                {
                                                    "contains": [
                                                        "@coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['SpecificTimesCsv'], '')",
                                                        "@formatDateTime(convertTimeZone(variables('nowUtc'), 'UTC', coalesce(body('FILTER_Schedules_For_Current_Workload')?[0]?['TimeZoneId'], 'UTC')), 'HH:mm')"
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        "actions": {
                            "SCOPE_Try_Dispatch": {
                                "type": "Scope",
                                "actions": {
                                    "WORKFLOW_Call_Discovery_Orchestrator_For_Workload": {
                                        "type": "Workflow",
                                        "inputs": {
                                            "host": {
                                                "workflow": {
                                                    "id": "wf-orchestrator-discovery"
                                                }
                                            },
                                            "method": "POST",
                                            "body": {
                                                "workloadId": "@items('FOREACH_Workload')?['PartitionKey']",
                                                "partnerId": "@items('FOREACH_Workload')?['PartnerId']",
                                                "sourceType": "@items('FOREACH_Workload')?['SourceType']",
                                                "sourceConfigCode": "@items('FOREACH_Workload')?['SourceConfigCode']",
                                                "watermarkFromUtc": "@addMinutes(coalesce(body('FILTER_RunTimeState_For_Current_Workload')?[0]?['CommittedWatermarkUtc'], body('FILTER_RunTimeState_For_Current_Workload')?[0]?['InitialWatermarkUtc'], items('FOREACH_Workload')?['InitialWatermarkUtc']), mul(-1, coalesce(int(items('FOREACH_Workload')?['OverlapWindowMinutes']), 30)))",
                                                "correlationId": "@{concat(guid(), '/', items('FOREACH_Workload')?['PartitionKey'])}",
                                                "extDocumentTypesCsv": "@items('FOREACH_Workload')?['ExtDocumentTypesCsv']",
                                                "extDocStatusesCsv": "@items('FOREACH_Workload')?['ExtDocStatusesCsv']",
                                                "maxPagesPerRun": "@coalesce(int(items('FOREACH_Workload')?['MaxPagesPerRun']), 50)",
                                                "overlapWindowMinutes": "@coalesce(int(items('FOREACH_Workload')?['OverlapWindowMinutes']), 30)",
                                                "enableNotification": "@coalesce(items('FOREACH_Workload')?['EnableNotification'], false)",
                                                "notificationType": "@items('FOREACH_Workload')?['NotificationType']",
                                                "notifyOnErrorsOnly": "@coalesce(items('FOREACH_Workload')?['NotifyOnErrorsOnly'], true)",
                                                "notificationRecipient": "@items('FOREACH_Workload')?['NotificationRecipient']",
                                                "runtimeState": {
                                                    "lastStatus": "@body('FILTER_RunTimeState_For_Current_Workload')?[0]?['LastStatus']",
                                                    "lastRunStartedUtc": "@body('FILTER_RunTimeState_For_Current_Workload')?[0]?['LastRunStartedUtc']",
                                                    "committedWatermarkUtc": "@body('FILTER_RunTimeState_For_Current_Workload')?[0]?['CommittedWatermarkUtc']",
                                                    "initialWatermarkUtc": "@items('FOREACH_Workload')?['InitialWatermarkUtc']"
                                                },
                                                "dispatchedAtUtc": "@utcNow()"
                                            }
                                        }
                                    }
                                }
                            },
                            "SCOPE_Catch_Dispatch": {
                                "type": "Scope",
                                "actions": {
                                    "HTTP_Track_Dispatch_Failed_Event": {
                                        "type": "Http",
                                        "inputs": {
                                            "uri": "https://dc.services.visualstudio.com/v2/track",
                                            "method": "POST",
                                            "body": {
                                                "name": "Microsoft.ApplicationInsights.Event",
                                                "time": "@utcNow()",
                                                "iKey": "@appsetting('appinsights_instrumentation_key')",
                                                "data": {
                                                    "baseType": "EventData",
                                                    "baseData": {
                                                        "ver": 2,
                                                        "name": "DTS_DiscoveryDispatchFailed",
                                                        "properties": {
                                                            "workloadId": "@{items('FOREACH_Workload')?['PartitionKey']}",
                                                            "correlationId": "@{concat(items('FOREACH_Workload')?['PartitionKey'], '-dispatch-failed')}",
                                                            "error": "@{result('SCOPE_Try_Dispatch')?[0]?['error']?['message']}"
                                                        }
                                                    }
                                                }
                                            },
                                            "retryPolicy": {
                                                "type": "none"
                                            }
                                        }
                                    }
                                },
                                "runAfter": {
                                    "SCOPE_Try_Dispatch": [
                                        "Failed",
                                        "TimedOut",
                                        "Skipped"
                                    ]
                                }
                            }
                        },
                        "else": {
                            "actions": {}
                        },
                        "runAfter": {
                            "FILTER_Schedules_For_Current_Workload": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "TABLES_Get_Runtime_States_For_Active_Workloads": [
                        "Succeeded"
                    ],
                    "TABLES_Get_Schedules_For_Active_Workloads": [
                        "Succeeded"
                    ]
                },
                "operationOptions": "Sequential"
            }
        }
    },
    "kind": "Stateful"
}

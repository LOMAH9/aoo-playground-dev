                                                                }
                                                            }
                                                        },
                                                        "else": {
                                                            "actions": {}
                                                        }
                                                    }
                                                },
                                                "runAfter": {
                                                    "SET_Reset_CurrentDocuments": [
                                                        "Succeeded"
                                                    ]
                                                },
                                                "operationOptions": "Sequential"
                                            },
                                            "COMPOSE_Risk_Item": {
                                                "type": "Compose",
                                                "inputs": {
                                                    "externalId": "@items('FOREACH_Page_Risk')?['rootID']",
                                                    "umr": "@items('FOREACH_Page_Risk')?['docs']?[0]?['umr']",
                                                    "insuredName": "@items('FOREACH_Page_Risk')?['docs']?[0]?['insuredName']",
                                                    "inceptionDate": "@items('FOREACH_Page_Risk')?['docs']?[0]?['inceptionDate']",
                                                    "updatedAt": "@items('FOREACH_Page_Risk')?['updatedAt']",
                                                    "documents": "@variables('currentDocuments')"
                                                },
                                                "runAfter": {
                                                    "FOREACH_Doc_Filter": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "SET_Append_Risk": {
                                                "type": "AppendToArrayVariable",
                                                "inputs": {
                                                    "name": "riskItems",

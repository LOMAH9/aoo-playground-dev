// ── App Service Plan ───────────────────────────────────────────────────────────

resource servicePlan 'Microsoft.Web/serverfarms@2022-09-01' = {
  name: servicePlanName
  location: location
  tags: tags
  sku: {
    name: 'WS1'
    tier: 'WorkflowStandard'
  }
  kind: 'windows'
  properties: {
    targetWorkerCount: 1
    targetWorkerSizeId: 0
    maximumElasticWorkerCount: 20

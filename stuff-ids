{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "HTTP_Trigger": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": ["function", "configCode", "correlationId"],
            "properties": {
              "function":         { "type": "string", "enum": ["GetDocumentsMetadata", "DownloadDocumentToStaging", "UploadDocumentFromPath"] },
              "configCode":       { "type": "string" },
              "workloadId":     { "type": "string" },
              "externalId":           { "type": "string" },
              "documentId":       { "type": "string" },
              "revision":         { "type": "string" },
              "fileName":         { "type": "string" },
              "contentType":      { "type": "string" },
              "stagingBlobPath":  { "type": "string" },
              "targetFolderPath": { "type": "string" },
              "watermarkFrom":    { "type": "string" },
              "nextKey":          { "type": "string" },
              "correlationId":    { "type": "string" }
            }
          }
        }
      }
    },
    "actions": {

      "INIT_Variables": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name":  "correlationId",
              "type":  "string",
              "value": "@coalesce(triggerOutputs()?['headers']?[appsetting('correlation_id_header')], triggerBody()?['correlationId'], '')"
            }
          ]
        }
      },

      "IF_Assert_CorrelationId_Consistent": {
        "type": "If",
        "runAfter": { "INIT_Variables": ["Succeeded"] },
        "expression": {
          "and": [
            { "not": { "empty": ["@coalesce(triggerOutputs()?['headers']?[appsetting('correlation_id_header')], '')"] } },
            { "not": { "empty": ["@coalesce(triggerBody()?['correlationId'], '')"] } },
            { "not": { "equals": ["@triggerOutputs()?['headers']?[appsetting('correlation_id_header')]", "@triggerBody()?['correlationId']"] } }
          ]
        },
        "actions": {
          "Response_CorrelationId_Mismatch": {
            "type": "Response",
            "runAfter": {},
            "inputs": {
              "statusCode": 400,
              "body": { "error": "correlationId in request header and body must match when both are provided" }
            }
          },
          "Terminate_CorrelationId_Mismatch": {
            "type": "Terminate",
            "runAfter": { "Response_CorrelationId_Mismatch": ["Succeeded"] },
            "inputs": {
              "runStatus": "Failed",
              "runError": { "code": "CorrelationIdMismatch", "message": "correlationId header and body values differ" }
            }
          }
        },
        "else": { "actions": {} }
      },

      "SWITCH_Function": {
        "type": "Switch",
        "expression": "@triggerBody()?['function']",
        "runAfter": { "IF_Assert_CorrelationId_Consistent": ["Succeeded"] },
        "cases": {

          "GetDocumentsMetadata": {
            "case": "GetDocumentsMetadata",
            "actions": {

              "COMPOSE_Source_Container": {
                "type": "Compose",
                "inputs": "@if(empty(trim(coalesce(triggerBody()?['configCode'], '')), appsetting('source_container_name'), coalesce(appsetting(concat(triggerBody()?['configCode'], '::source_container_name')), appsetting('source_container_name')))",
                "runAfter": {}
              },
              "COMPOSE_Source_Prefix": {
                "type": "Compose",
                "inputs": "@if(empty(trim(coalesce(triggerBody()?['configCode'], '')), appsetting('source_blob_prefix'), coalesce(appsetting(concat(triggerBody()?['configCode'], '::source_blob_prefix')), appsetting('source_blob_prefix')))",
                "runAfter": {}
              },

              "BLOB_List_Blobs": {
                "type": "ServiceProvider",
                "runAfter": {
                  "COMPOSE_Source_Container": ["Succeeded"],
                  "COMPOSE_Source_Prefix":    ["Succeeded"]
                },
                "inputs": {
                  "parameters": {
                    "containerName": "@outputs('COMPOSE_Source_Container')",
                    "prefix":        "@outputs('COMPOSE_Source_Prefix')"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName":    "azureBlob",
                    "operationId":       "listBlobs",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                }
              },

              "SELECT_Blob_Items": {
                "type": "Select",
                "runAfter": { "BLOB_List_Blobs": ["Succeeded"] },
                "inputs": {
                  "from": "@body('BLOB_List_Blobs')?['value']",
                  "select": {
                    "externalId":    "@item()?['name']",
                    "umr":           null,
                    "insuredName":   null,
                    "inceptionDate": null,
                    "status":        null,
                    "updatedAt":     "@item()?['properties']?['lastModified']",
                    "documents":     "@createArray(createObject('documentId', item()?['name'], 'parentDocumentId', null, 'revision', item()?['properties']?['etag'], 'fileName', last(split(item()?['name'], '/')), 'digest', item()?['properties']?['contentMD5'], 'contentType', item()?['properties']?['contentType'], 'sizeBytes', item()?['properties']?['contentLength']))"
                  }
                }
              },

              "COMPOSE_GetMetadata_Response": {
                "type": "Compose",
                "runAfter": { "SELECT_Blob_Items": ["Succeeded"] },
                "inputs": {
                  "items":       "@body('SELECT_Blob_Items')",
                  "hasMore":     false,
                  "nextKey":     "",
                  "watermarkTo": "@utcNow()"
                }
              },

              "Response_GetMetadata": {
                "type": "Response",
                "runAfter": { "COMPOSE_GetMetadata_Response": ["Succeeded"] },
                "inputs": { "statusCode": 200, "body": "@outputs('COMPOSE_GetMetadata_Response')" }
              }

            }
          },

          "DownloadDocumentToStaging": {
            "case": "DownloadDocumentToStaging",
            "actions": {

              "COMPOSE_Source_Container_Dl": {
                "type": "Compose",
                "inputs": "@if(empty(trim(coalesce(triggerBody()?['configCode'], '')), appsetting('source_container_name'), coalesce(appsetting(concat(triggerBody()?['configCode'], '::source_container_name')), appsetting('source_container_name')))",
                "runAfter": {}
              },
              "COMPOSE_Staging_Blob_Path": {
                "type": "Compose",
                "inputs": "@{concat('staging/', triggerBody()?['workloadId'], '/', triggerBody()?['externalId'], '/', triggerBody()?['documentId'], '-', triggerBody()?['revision'])}",
                "runAfter": {}
              },

              "BLOB_Download_Source": {
                "type": "ServiceProvider",
                "runAfter": {
                  "COMPOSE_Source_Container_Dl": ["Succeeded"],
                  "COMPOSE_Staging_Blob_Path":   ["Succeeded"]
                },
                "inputs": {
                  "parameters": {
                    "containerName": "@outputs('COMPOSE_Source_Container_Dl')",
                    "blobName":      "@triggerBody()?['documentId']"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName":    "azureBlob",
                    "operationId":       "readBlob",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                }
              },

              "BLOB_Upload_To_Staging": {
                "type": "ServiceProvider",
                "runAfter": { "BLOB_Download_Source": ["Succeeded"] },
                "inputs": {
                  "parameters": {
                    "containerName": "@appsetting('blob_staging_container')",
                    "blobName":      "@outputs('COMPOSE_Staging_Blob_Path')",
                    "content":       "@body('BLOB_Download_Source')?['content']",
                    "overwrite":     false,
                    "metadata": {
                      "partnerrevision":   "@triggerBody()?['revision']",
                      "workloadcode":      "@triggerBody()?['workloadId']",
                      "partnerexternalid": "@triggerBody()?['externalId']"
                    }
                  },
                  "serviceProviderConfiguration": {
                    "connectionName":    "azureBlob",
                    "operationId":       "uploadBlob",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                }
              },

              "Response_Download": {
                "type": "Response",
                "runAfter": { "BLOB_Upload_To_Staging": ["Succeeded"] },
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "stagingBlobPath": "@outputs('COMPOSE_Staging_Blob_Path')",
                    "actualDigest":    "",
                    "contentType":     "@triggerBody()?['contentType']",
                    "sizeBytes":       "@body('BLOB_Download_Source')?['properties']?['contentLength']"
                  }
                }
              }

            }
          },

          "UploadDocumentFromPath": {
            "case": "UploadDocumentFromPath",
            "actions": {

              "COMPOSE_Dest_Container": {
                "type": "Compose",
                "inputs": "@if(empty(trim(coalesce(triggerBody()?['configCode'], '')), appsetting('destination_container_name'), coalesce(appsetting(concat(triggerBody()?['configCode'], '::destination_container_name')), appsetting('destination_container_name')))",
                "runAfter": {}
              },
              "COMPOSE_Dest_Blob_Path": {
                "type": "Compose",
                "inputs": "@{concat(triggerBody()?['targetFolderPath'], '/', triggerBody()?['fileName'])}",
                "runAfter": {}
              },

              "BLOB_Download_From_Staging_Upload": {
                "type": "ServiceProvider",
                "runAfter": {
                  "COMPOSE_Dest_Container": ["Succeeded"],
                  "COMPOSE_Dest_Blob_Path":  ["Succeeded"]
                },
                "inputs": {
                  "parameters": {
                    "containerName": "@appsetting('blob_staging_container')",
                    "blobName":      "@triggerBody()?['stagingBlobPath']"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName":    "azureBlob",
                    "operationId":       "readBlob",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                }
              },

              "BLOB_Upload_To_Dest": {
                "type": "ServiceProvider",
                "runAfter": { "BLOB_Download_From_Staging_Upload": ["Succeeded"] },
                "inputs": {
                  "parameters": {
                    "containerName": "@outputs('COMPOSE_Dest_Container')",
                    "blobName":      "@outputs('COMPOSE_Dest_Blob_Path')",
                    "content":       "@body('BLOB_Download_From_Staging_Upload')?['content']",
                    "overwrite":     false
                  },
                  "serviceProviderConfiguration": {
                    "connectionName":    "azureBlob",
                    "operationId":       "uploadBlob",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                }
              },

              "Response_Upload": {
                "type": "Response",
                "runAfter": { "BLOB_Upload_To_Dest": ["Succeeded"] },
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "targetPath": "@{concat(outputs('COMPOSE_Dest_Container'), '/', outputs('COMPOSE_Dest_Blob_Path'))}",
                    "targetETag": ""
                  }
                }
              }

            }
          }

        },
        "default": {
          "actions": {
            "Response_Unsupported": {
              "type": "Response",
              "inputs": {
                "statusCode": 400,
                "body": { "error": "@{concat('Unsupported function: ', triggerBody()?['function'])}" }
              },
              "runAfter": {}
            }
          }
        }
      }

    },
    "outputs": {}
  },
  "kind": "Stateful"
}

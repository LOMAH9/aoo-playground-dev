                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "watermarkToInternal",
                                                    "value": "@first(body('PARSE_Page_Result'))?['updatedAt']"
                                                }
                                            }
                                        },
                                        "else": {
                                            "actions": {}
                                        },
                                        "runAfter": {
                                            "PARSE_Page_Result": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "FOREACH_Page_Risk": {
                                        "type": "Foreach",
                                        "foreach": "@body('PARSE_Page_Result')",
                                        "actions": {
                                            "SET_Reset_CurrentDocuments": {
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "currentDocuments",
                                                    "value": []
                                                }
                                            },
                                            "FOREACH_Doc_Filter": {
                                                "type": "Foreach",
                                                "foreach": "@coalesce(items('FOREACH_Page_Risk')?['docs'], createArray())",
                                                "actions": {
                                                    "IF_Doc_Matches_Filters": {
                                                        "type": "If",
                                                        "expression": {
                                                            "and": [
                                                                {
                                                                    "or": [
                                                                        {
                                                                            "empty": [
                                                                                "@coalesce(triggerBody()?['filters']?['extDocStatusesCsv'], '')"
                                                                            ]
                                                                        },
                                                                        {
                                                                            "contains": [
                                                                                "@concat(',', coalesce(triggerBody()?['filters']?['extDocStatusesCsv'], ''), ',')",
                                                                                "@concat(',', items('FOREACH_Doc_Filter')?['status'], ',')"
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "or": [
                                                                        {
                                                                            "empty": [
                                                                                "@coalesce(triggerBody()?['filters']?['extDocumentTypesCsv'], '')"
                                                                            ]
                                                                        },
                                                                        {
                                                                            "contains": [
                                                                                "@concat(',', coalesce(triggerBody()?['filters']?['extDocumentTypesCsv'], ''), ',')",
                                                                                "@concat(',', items('FOREACH_Doc_Filter')?['type'], ',')"
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        "actions": {
                                                            "APPEND_Api_Doc": {
                                                                "type": "AppendToArrayVariable",
                                                                "inputs": {
                                                                    "name": "currentDocuments",
                                                                    "value": {
                                                                        "documentId":       "@concat(items('FOREACH_Page_Risk')?['rootID'], '|', items('FOREACH_Doc_Filter')?['type'])",
                                                                        "externalId":       "@items('FOREACH_Doc_Filter')?['id']",
                                                                        "externalType":     "@items('FOREACH_Doc_Filter')?['type']",
                                                                        "documentKind":     "@if(equals(items('FOREACH_Doc_Filter')?['type'], 'RWAttachmentCollection'), 'Attachment', if(equals(items('FOREACH_Doc_Filter')?['status'], 'Endorsement'), 'Endorsement', 'Submission'))",
                                                                        "placementType":    "@items('FOREACH_Doc_Filter')?['placementType']",
                                                                        "parentDocumentId": "@items('FOREACH_Page_Risk')?['rootID']",
                                                                        "revision":         "@coalesce(items('FOREACH_Doc_Filter')?['rev'], '1')",
                                                                        "fileName":         "@if(equals(items('FOREACH_Doc_Filter')?['type'], 'RWAttachmentCollection'), null, concat(replace(replace(coalesce(items('FOREACH_Doc_Filter')?['umr'], items('FOREACH_Page_Risk')?['rootID']), '/', '_'), ':', '-'), '.pdf'))",
                                                                        "digest":           null,
                                                                        "contentType":      "@if(equals(items('FOREACH_Doc_Filter')?['type'], 'RWAttachmentCollection'), null, 'application/pdf')",
                                                                        "sizeBytes":        0,
                                                                        "status":           "@items('FOREACH_Doc_Filter')?['status']",
                                                                        "lastUpdatedAt":    "@items('FOREACH_Doc_Filter')?['lastUpdatedAt']"
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "else": {
                                                            "actions": {}
                                                        }
                                                    }
                                                },
                                                "runAfter": {
                                                    "SET_Reset_CurrentDocuments": [
                                                        "Succeeded"
                                                    ]
                                                },
                                                "operationOptions": "Sequential"
                                            },
                                            "COMPOSE_Risk_Item": {
                                                "type": "Compose",
                                                "inputs": {
                                                    "externalId": "@items('FOREACH_Page_Risk')?['rootID']",
                                                    "umr": "@items('FOREACH_Page_Risk')?['docs']?[0]?['umr']",
                                                    "insuredName": "@items('FOREACH_Page_Risk')?['docs']?[0]?['insuredName']",
                                                    "inceptionDate": "@items('FOREACH_Page_Risk')?['docs']?[0]?['inceptionDate']",
                                                    "updatedAt": "@items('FOREACH_Page_Risk')?['updatedAt']",
                                                    "documents": "@variables('currentDocuments')"
                                                },
                                                "runAfter": {
                                                    "FOREACH_Doc_Filter": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "SET_Append_Risk": {
                                                "type": "AppendToArrayVariable",
                                                "inputs": {
                                                    "name": "riskItems",
                                                    "value": "@outputs('COMPOSE_Risk_Item')"
                                                },
                                                "runAfter": {
                                                    "COMPOSE_Risk_Item": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            }
                                        },
                                        "runAfter": {
                                            "IF_Set_Watermark_Initial": [
                                                "Succeeded"
                                            ]
                                        },
                                        "operationOptions": "Sequential"
                                    },
                                    "SET_More_Pages": {
                                        "type": "SetVariable",
                                        "inputs": {
                                            "name": "pageMoreItems",
                                            "value": "@and(equals(length(body('PARSE_Page_Result')), 60), greaterOrEquals(ticks(last(body('PARSE_Page_Result'))?['updatedAt']), ticks(coalesce(triggerBody()?['watermarkFrom'], '2000-01-01T00:00:00Z'))))"
                                        },
                                        "runAfter": {
                                            "FOREACH_Page_Risk": [
                                                "Succeeded",
                                                "Failed"
                                            ]
                                        }
                                    },
                                    "SET_Page_Next_Key": {
                                        "type": "SetVariable",
                                        "inputs": {
                                            "name": "pageNextKey",
                                            "value": "@if(greater(length(body('PARSE_Page_Result')), 0), concat(last(body('PARSE_Page_Result'))?['rootID'], '|', last(body('PARSE_Page_Result'))?['updatedAt']), '')"
                                        },
                                        "runAfter": {
                                            "FOREACH_Page_Risk": [
                                                "Succeeded",
                                                "Failed"
                                            ]
                                        }
                                    },
                                    "INCREMENT_Pages_Read": {
                                        "type": "IncrementVariable",
                                        "inputs": {
                                            "name": "pagesReadCount",
                                            "value": 1
                                        },
                                        "runAfter": {
                                            "SET_More_Pages": [
                                                "Succeeded"
                                            ],
                                            "SET_Page_Next_Key": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "SET_Abort_Loop_On_API_Error": {
                                        "type": "SetVariable",
                                        "inputs": {
                                            "name": "pageMoreItems",
                                            "value": false
                                        },
                                        "runAfter": {
                                            "HTTP_Get_Risks_Summary_Page": [
                                                "Failed",
                                                "TimedOut"
                                            ]
                                        }
                                    }
                                }
                            },
                            "COMPOSE_GetDocumentsMetadata_Response": {
                                "type": "Compose",
                                "inputs": {
                                    "items": "@variables('riskItems')",
                                    "watermarkTo": "@variables('watermarkToInternal')",
                                    "pagesRead": "@variables('pagesReadCount')"
                                },
                                "runAfter": {
                                    "UNTIL_All_Pages": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "Response_GetDocumentsMetadata": {
                                "type": "Response",
                                "inputs": {
                                    "statusCode": 200,
                                    "body": "@outputs('COMPOSE_GetDocumentsMetadata_Response')"
                                },
                                "runAfter": {
                                    "COMPOSE_GetDocumentsMetadata_Response": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "Response_GetDocumentsMetadata_Error": {
                                "type": "Response",
                                "inputs": {
                                    "statusCode": 500,
                                    "body": {
                                        "error": "GetDocumentsMetadata failed",
                                        "workloadId": "@triggerBody()?['workloadId']"
                                    }
                                },
                                "runAfter": {
                                    "UNTIL_All_Pages": [
                                        "Failed",
                                        "TimedOut"
                                    ]
                                }
                            }
                        },
                        "case": "GetDocumentsMetadata"
                    }
                },
                "runAfter": {
                    "IF_Assert_CorrelationId_Consistent": [
                        "Succeeded"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "Stateful"
}

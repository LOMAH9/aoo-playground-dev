param logicAppSubnetId string
param storageSubnetId string

// ── Logic App backing (config) storage ────────────────────────────────────────
// Hosts Logic App state, artifact cache, and workflow definitions at runtime.
// Naming: sta + locationCode + dts + config + env
// Network access restrictions are applied manually by the infrastructure team.

var configStorageName = 'sta${locationCode}dtsconfig${environment}'

resource configStorage 'Microsoft.Storage/storageAccounts@2023-01-01' = {
  name: configStorageName
  location: location
  tags: tags
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: {
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
    supportsHttpsTrafficOnly: true
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
      virtualNetworkRules: []
      ipRules: []
    }
  }
}

// ── Private DNS zones (existing, in same resource group) ──────────────────────

resource dnsZoneBlob 'Microsoft.Network/privateDnsZones@2020-06-01' existing = {
  name: 'privatelink.blob.${az.environment().suffixes.storage}'
}

resource dnsZoneFile 'Microsoft.Network/privateDnsZones@2020-06-01' existing = {
  name: 'privatelink.file.${az.environment().suffixes.storage}'
